APP_ENV=development

DATABASE_URL=postgresql+asyncpg://login:password@localhost:15432/concerts_afisha_db
DATABASE_USER=DATABASE_USER
DATABASE_PASSWORD=DATABASE_PASSWORD

HASH_SCHEME=argon2id
